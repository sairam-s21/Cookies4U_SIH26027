# Caddy automatically provisions and renews a real Let's Encrypt TLS
# certificate for this domain the first time it starts -- no certbot, no
# cron renewal job, no manual cert paths. Required because the frontend
# (Vercel, HTTPS) can't call a plain-HTTP backend from a browser (mixed
# content is blocked) -- a self-signed cert doesn't fix this either,
# since browsers reject it as untrusted.
#
# Replace YOUR_DOMAIN_HERE with the real domain/subdomain pointed at this
# VM's public IP (see docs/ORACLE_DEPLOY.md) before copying this file to
# /etc/caddy/Caddyfile.
YOUR_DOMAIN_HERE {
	reverse_proxy 127.0.0.1:8000
}
